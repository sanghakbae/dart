# DART OpenAPI 인증키 (https://opendart.fss.or.kr).
# VITE_ 접두사가 없어 번들에 들어가지 않는다 — 개발 서버 프록시와
# `npm run build:corp` 에서만 쓴다. 없으면 'DART 에서 가져오기' 가 동작하지 않는다.
DART_API_KEY=

# 국민연금 가입 사업장 내역 (https://www.data.go.kr) — 고용 추이용. 아직 미사용.
NPS_API_KEY=

# Firebase 웹앱 설정 — 기본값이 src/firebase.js 에 내장되어 있어 비워둬도 동작한다.
# 다른 Firebase 프로젝트를 쓰려면 여기서 덮어쓴다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
