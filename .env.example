# DART OpenAPI 인증키 (https://opendart.fss.or.kr).
# VITE_ 접두사가 없어 번들에 들어가지 않는다 — 개발 서버 프록시와
# `npm run build:corp` 에서만 쓴다. 없으면 'DART 에서 가져오기' 가 동작하지 않는다.
DART_API_KEY=

# 국민연금 가입 사업장 내역 (https://www.data.go.kr) — 고용 추이용. 아직 미사용.
NPS_API_KEY=

# Firebase 웹앱 설정 — 기본값이 src/firebase.js 에 내장되어 있어 비워둬도 동작한다.
# 다른 Firebase 프로젝트를 쓰려면 여기서 덮어쓴다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# KIPRIS Plus 특허·상표·디자인 검색 (https://plus.kipris.or.kr) — 인증 파라미터는 accessKey 다.
# 세 서비스를 각각 활용신청해야 한다(특허만 신청하면 상표·디자인은 31 로 떨어진다).
KIPRIS_API_KEY=

# 국세청 사업자등록 상태 · 조달청 나라장터 낙찰정보 (https://www.data.go.kr).
# 국민연금과 같은 포털이고 인증키는 계정당 하나이므로, 두 서비스를 활용신청해 두었다면
# 비워 둬도 NPS_API_KEY 를 그대로 쓴다. '디코딩' 키를 넣는다(인코딩 키는 이중 인코딩된다).
NTS_API_KEY=
G2B_API_KEY=
