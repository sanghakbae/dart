{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dart-proxy",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-07-01",

  // 인증키는 코드·설정에 넣지 않는다. 시크릿으로만 둔다:
  //   wrangler secret put DART_API_KEY
  //   wrangler secret put NPS_API_KEY
  //   wrangler secret put KIPRIS_API_KEY
  //   wrangler secret put NTS_API_KEY
  //
  // 허용 오리진 추가가 필요하면(미리보기 도메인 등) 쉼표로 구분해 넣는다.
  // 기본 허용은 server/worker.mjs 의 ALLOWED 목록.
  "vars": {
    "ALLOWED_ORIGINS": ""
  },

  // 국민연금(apis.data.go.kr)이 Cloudflare 기본 실행 위치에서 2.4초 만에
  // SERVICETIMEOUT_ERROR 로 끊긴다(같은 호출이 국내 회선에서는 6.5초 걸려 성공).
  // Smart Placement 는 상류에 가까운 곳에서 Worker 를 돌려 왕복을 줄인다.
  "placement": {
    "mode": "smart"
  },

  "observability": {
    "enabled": true
  }
}
