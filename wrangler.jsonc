{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dart-proxy",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-07-01",

  // 인증키는 코드·설정에 넣지 않는다. 시크릿으로만 둔다:
  //   wrangler secret put DART_API_KEY
  //   wrangler secret put NPS_API_KEY
  //
  // 허용 오리진 추가가 필요하면(미리보기 도메인 등) 쉼표로 구분해 넣는다.
  // 기본 허용은 server/worker.mjs 의 ALLOWED 목록.
  "vars": {
    "ALLOWED_ORIGINS": ""
  },

  "observability": {
    "enabled": true
  }
}
