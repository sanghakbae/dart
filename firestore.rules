rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 구글 로그인을 붙인 뒤로 익명 접근은 모두 막는다.
    // 감사보고서 원문이 통째로 들어 있어 공개해 둘 수 없다.
    //
    //   로그인한 사용자 → 열람 · 업로드 · 삭제
    //   관리자          → 위 + 이용 현황(users 컬렉션) 조회
    //
    // 구조: companies/{회사}/reports/{연도-기간-연결여부}/content/{청크}

    function signedIn() {
      return request.auth != null;
    }

    // 관리자 목록. src/lib/auth.js 의 ADMIN_EMAILS 와 반드시 같이 고쳐야 한다.
    // (저쪽은 메뉴를 숨길 뿐이고 실제 차단은 여기서 한다)
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['totoriverce@tukorea.ac.kr'];
    }

    function schemaOk() {
      return request.resource.data.keys().hasAll(['key', 'periods'])
        && request.resource.data.periods is map;
    }

    // 이용 현황. 본인 문서만 쓸 수 있고, 전체 목록은 관리자만 읽는다.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    match /companies/{companyKey} {
      // 단건 조회(get)는 로그인한 사용자면 된다.
      //
      // 업로드는 회사 문서를 읽고-합치고-쓰는 트랜잭션이다(storage.saveToFirestore).
      // 읽기를 소유자로 잠그면, 남이 먼저 올린 회사에 다른 연도를 보태려는 순간
      // 그 트랜잭션의 get 이 막혀 "권한이 없습니다" 로 끝난다 — 두산퓨얼셀에서 그랬다.
      // 어차피 보고서 원문·본문(reports/content)은 이미 로그인한 누구나 읽으므로,
      // 요약인 회사 문서만 잠가 둘 이유가 없다.
      allow get: if signedIn();

      // 목록(list)은 여전히 '내가 올린 것 + 공통 노출'만 보인다. 이 조건에 맞는
      // 쿼리로만 성공한다(src/lib/storage.js listCompanies 참고).
      allow list: if signedIn() && (
        isAdmin()
        || resource.data.get('shared', false) == true
        || resource.data.get('ownerUid', '') == request.auth.uid
      );

      // 삭제는 로그인한 사용자 누구나 할 수 있다. 공유 저장소라 남이 올린 자료도
      // 지울 수 있으므로 화면에서 한 번 더 확인을 받는다.
      allow delete: if signedIn();

      // 형식이 맞는 문서만 받아 잡다한 쓰기를 걸러낸다(보안 경계는 아니다).
      allow create: if signedIn() && schemaOk();
      // 공통 노출 지정은 관리자만. 일반 사용자의 누적 쓰기는 shared 를 건드릴 수 없다.
      allow update: if signedIn() && schemaOk() && (
        isAdmin()
        || request.resource.data.get('shared', false) == resource.data.get('shared', false)
      );

      // 국민연금 고용 정보 캐시(하루 1회 갱신). 감사보고서 원문이 아니라
      // 공개 API 결과라 로그인한 사용자면 읽고 쓸 수 있다.
      match /employment/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasAll(['fetchedAt'])
          && request.resource.data.fetchedAt is int;
        allow delete: if signedIn();
      }

      // 자본조달 이력 캐시(하루 1회 갱신). 고용 캐시와 같은 성격이다.
      match /funding/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasAll(['fetchedAt'])
          && request.resource.data.fetchedAt is int;
        allow delete: if signedIn();
      }

      // 국세청 사업자 상태 캐시(하루 1회 갱신).
      match /bizstatus/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasAll(['fetchedAt'])
          && request.resource.data.fetchedAt is int;
        allow delete: if signedIn();
      }

      // 특허 캐시(하루 1회 갱신).
      match /patents/{docId} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasAll(['fetchedAt'])
          && request.resource.data.fetchedAt is int;
        allow delete: if signedIn();
      }

      match /reports/{reportId} {
        allow read: if signedIn();
        allow delete: if signedIn();
        allow create, update: if signedIn()
          && request.resource.data.keys().hasAll(['meta', 'createdAt'])
          && request.resource.data.meta is map;

        // 원문 · 표 · 주석 본문 청크
        match /content/{chunkId} {
          allow read: if signedIn();
          allow create, update: if signedIn();
          allow delete: if signedIn(); // 같은 보고서를 다시 올릴 때 이전 청크를 교체해야 한다
        }
      }
    }
  }
}
